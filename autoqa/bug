#!/bin/bash
echo "🚀 Starting AutoQA System..."

# Check if redis is running (optional but helpful)
if ! nc -z localhost 6379; then
  echo "⚠️  Warning: Redis doesn't seem to be running on port 6379."
  echo "   You might need to run: docker run -d -p 6379:6379 redis"
fi

# Run all 4 processes concurrently using npx
npx concurrently --kill-others --names "WORKER,SERVER,DASHBOARD,WATCHER" --prefix-colors "cyan,magenta,yellow,green" \
  "npx tsx ./packages/cli/bin/autoqa.ts worker" \
  "npx tsx ./packages/cli/bin/autoqa.ts dashboard-server" \
  "npm run dev --workspace=@autoqa/dashboard" \
  "npx tsx ./packages/cli/bin/autoqa.ts watch --url http://localhost:3000"
