generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id         String   @id @default(uuid())
  name       String
  repoPath   String
  localUrl   String
  createdAt  DateTime @default(now())
  commits    Commit[]
  features   Feature[]
}

model Commit {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  hash          String
  diffSummary   String
  analyzedAt    DateTime @default(now())
  features      Feature[]
}

model Feature {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  commitId      String?
  commit        Commit?  @relation(fields: [commitId], references: [id])
  name          String
  description   String
  status        String   // discovered | testing | verified | broken
  firstSeenAt   DateTime @default(now())
  testRuns      TestRun[]
}

model TestRun {
  id            String   @id @default(uuid())
  featureId     String
  feature       Feature  @relation(fields: [featureId], references: [id])
  triggeredBy   String   // auto | manual
  status        String   // queued | running | passed | failed
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  testCases     TestCase[]
}

model TestCase {
  id             String   @id @default(uuid())
  testRunId      String
  testRun        TestRun  @relation(fields: [testRunId], references: [id])
  type           String   // ui | api
  description    String
  status         String   // pass | fail
  durationMs     Int?
  bugReports     BugReport[]
}

model BugReport {
  id               String   @id @default(uuid())
  testCaseId       String
  testCase         TestCase @relation(fields: [testCaseId], references: [id])
  severity         String
  title            String
  expected         String
  actual           String
  screenshotPath   String?
  notifications    Notification[]
}

model Notification {
  id            String    @id @default(uuid())
  bugReportId   String
  bugReport     BugReport @relation(fields: [bugReportId], references: [id])
  channel       String
  sentAt        DateTime  @default(now())
}
